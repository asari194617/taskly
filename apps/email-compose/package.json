{
  "name": "email-compose",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p . && npm run postbuild",
    "postbuild": "mkdir -p dist/proto dist/messages && cp -R src/proto/* dist/proto/ && cp -R src/messages/* dist/messages/",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "dev": "node --import=dd-trace/experimental-hooks/register -r dotenv/config dist/index.js",
    "start": "node --import=dd-trace/experimental-hooks/register dist/index.js",
    "email:dev": "email dev --dir src"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@react-email/render": "^2.1.0",
    "@react-email/ui": "^6.9.5",
    "@sentry/node": "10.75.1",
    "@sentry/profiling-node": "10.75.1",
    "dd-trace": "6.16.0",
    "dotenv": "18.0.1",
    "google-protobuf": "^4.0.3",
    "i18next": "^26.3.5",
    "i18next-resources-to-backend": "^1.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.9.5",
    "react-i18next": "17.0.14",
    "redis": "^6.2.1",
    "tslog": "^5.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
