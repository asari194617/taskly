{
  "name": "email-compose",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p . && npm run postbuild",
    "postbuild": "mkdir -p dist/proto dist/messages && cp -R src/proto/* dist/proto/ && cp -R src/messages/* dist/messages/",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "dev": "node --import=dd-trace/experimental-hooks/register -r dotenv/config dist/index.js",
    "start": "node --import=dd-trace/experimental-hooks/register dist/index.js",
    "email:dev": "email dev --dir src"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@react-email/render": "^2.1.1",
    "@sentry/node": "11.8.0",
    "@sentry/profiling-node": "11.8.0",
    "dd-trace": "6.21.0",
    "dotenv": "18.0.9",
    "google-protobuf": "^4.0.3",
    "i18next": "^26.5.3",
    "i18next-resources-to-backend": "^1.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.3",
    "react-i18next": "17.1.3",
    "redis": "^6.3.0",
    "tslog": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "next": "16.4.2"
  }
}
