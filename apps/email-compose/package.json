{
  "name": "email-compose",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p . && npm run postbuild",
    "postbuild": "mkdir -p dist/proto dist/messages && cp -R src/proto/* dist/proto/ && cp -R src/messages/* dist/messages/",
    "dev": "node --import=dd-trace/experimental-hooks/register -r dotenv/config dist/index.js",
    "start": "node --import=dd-trace/experimental-hooks/register dist/index.js",
    "email:dev": "email dev --dir src"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@react-email/render": "^2.1.0",
    "@react-email/ui": "^6.8.1",
    "@sentry/node": "^10.64.0",
    "@sentry/profiling-node": "^10.65.0",
    "dd-trace": "^6.3.0",
    "dotenv": "^17.4.2",
    "google-protobuf": "^4.0.2",
    "i18next": "^26.3.5",
    "i18next-resources-to-backend": "^1.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "redis": "^6.1.0",
    "tslog": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "react-email": "^6.8.1",
    "typescript": "^7.0.2"
  }
}
