{
  "name": "email-compose",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p . && npm run postbuild",
    "postbuild": "mkdir -p dist/proto dist/messages && cp -R src/proto/* dist/proto/ && cp -R src/messages/* dist/messages/",
    "dev": "node --import=dd-trace/experimental-hooks/register -r dotenv/config dist/index.js",
    "start": "node --import=dd-trace/experimental-hooks/register dist/index.js",
    "email:dev": "email dev --dir src"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@react-email/components": "^1.0.6",
    "@react-email/render": "^2.0.4",
    "@sentry/node": "^10.64.0",
    "@sentry/profiling-node": "^10.64.0",
    "dd-trace": "^5.83.0",
    "dotenv": "^17.2.3",
    "google-protobuf": "^4.0.1",
    "i18next": "^25.8.0",
    "i18next-resources-to-backend": "^1.2.1",
    "react-i18next": "^15.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "redis": "^5.10.0",
    "tslog": "^4.10.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@react-email/preview-server": "5.2.5",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "react-email": "5.2.5",
    "typescript": "^5.9.3"
  }
}
