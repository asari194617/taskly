{
  "name": "email-compose",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p . && npm run postbuild",
    "postbuild": "mkdir -p dist/proto dist/locales && cp -R src/proto/* dist/proto/ && cp -R src/locales/* dist/locales/",
    "dev": "node --import=dd-trace/experimental-hooks/register -r dotenv/config dist/index.js",
    "start": "node --import=dd-trace/experimental-hooks/register dist/index.js"
  },
  "dependencies": {
    "@react-email/components": "^0.0.21",
    "@react-email/render": "^0.0.15",
    "@sentry/node": "^8.28.0",
    "@sentry/profiling-node": "^8.28.0",
    "dd-trace": "^5.20.1",
    "dotenv": "^16.4.5",
    "google-protobuf": "^3.21.2",
    "i18next": "^23.11.5",
    "i18next-fs-backend": "^2.3.1",
    "redis": "^4.6.14",
    "tslog": "^4.9.3",
    "zod": "^3.23.8",
    "@grpc/grpc-js": "^1.10.7",
    "@grpc/proto-loader": "^0.7.13",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.1",
    "@types/react": "^18.3.5",
    "typescript": "^5.6.3"
  }
}
