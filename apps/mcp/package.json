{
  "name": "taskly-mcp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "link": "npm link",
    "test": "npm run build && npm run test:unit && node --test tests/*.test.mjs",
    "test:unit": "tsc -p tsconfig.test.json && node --test dist-test/__tests__/*.test.js",
    "test:watch": "tsc -p tsconfig.test.json && node --test --watch dist-test/__tests__/*.test.js"
  },
  "bin": {
    "taskly-mcp": "bin/taskly-mcp"
  },
  "dependencies": {
    "fastify": "5.12.1",
    "fastify-plugin": "6.0.0",
    "mysql2": "3.24.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3",
    "undici": "6.28.1"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "7.0.2",
    "jest": "30.5.0",
    "ts-jest": "29.4.12",
    "@types/jest": "30.0.0",
    "@jest/types": "30.5.0"
  }
}
