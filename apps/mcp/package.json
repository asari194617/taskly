{
  "name": "taskly-mcp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "link": "npm link",
    "test": "npm run build && npm run test:unit && node --test tests/*.test.mjs",
    "test:unit": "tsc -p tsconfig.test.json && node --test dist-test/__tests__/*.test.js",
    "test:watch": "tsc -p tsconfig.test.json && node --test --watch dist-test/__tests__/*.test.js"
  },
  "bin": {
    "taskly-mcp": "bin/taskly-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "mysql2": "3.24.6",
    "undici": "8.12.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "c8": "^12.0.0",
    "typescript": "7.0.2"
  }
}
