{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["astro/client", "vite/client"],
    "moduleResolution": "Bundler",
    "allowJs": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  }
}
