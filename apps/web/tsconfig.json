{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["astro/client", "vite/client", "node"],
    "moduleResolution": "Bundler",
    "allowJs": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0"
  },
  "exclude": ["dist", "public", "node_modules"]
}
