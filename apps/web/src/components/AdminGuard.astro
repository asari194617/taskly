<div
  id="admin-guard-error"
  style="display:none; padding:12px; margin:12px 0; border:1px solid #e53e3e; background:#fff5f5; color:#c53030; border-radius:6px; font-size:14px;"
>
</div>
<script type="module">
  const API_BASE =
    (import.meta.env && import.meta.env.PUBLIC_API_URL) ||
    "http://localhost:3063";
  (async () => {
    try {
      const url = new URL(location.href);
      const debug = url.searchParams.get("debug_admin_guard") === "1";
      const token = localStorage.getItem("api_token") || "";
      if (!token) {
        const next = encodeURIComponent(
          location.pathname + location.search + location.hash
        );
        if (!debug) location.href = `/login?next=${next}`;
        return;
      }
      const headers = {
        "Content-Type": "application/json",
        "X-Client-Platform": "web",
      };
      if (token)
        headers["Authorization"] = token.startsWith("Bearer ")
          ? token
          : `Bearer ${token}`;
      const res = await fetch(`${API_BASE}/graphql`, {
        method: "POST",
        headers,
        body: JSON.stringify({
          query: "query{ me{ id email is_admin is_manager } }",
        }),
      });
      if (!res.ok) {
        // HTTPステータスに応じて振る舞いを分岐
        if (res.status === 401 || res.status === 403) {
          // 認証・権限エラーはトークン破棄してログインへ
          try {
            localStorage.removeItem("api_token");
          } catch {}
          const next = encodeURIComponent(
            location.pathname + location.search + location.hash
          );
          if (!debug) location.href = `/login?next=${next}`;
          if (debug) {
            const msg = `認証エラー（HTTP ${res.status}）。API=${API_BASE}\nAuthorization=${headers["Authorization"]}`;
            const el = document.getElementById("admin-guard-error");
            if (el) {
              el.textContent = msg;
              el.style.display = "block";
            }
            console.error(msg);
          }
          return;
        } else {
          // それ以外は画面にエラー表示
          const msg = `サーバーエラーが発生しました（コード: ${res.status}）。時間を置いて再度お試しください。`;
          const el = document.getElementById("admin-guard-error");
          if (el) {
            el.textContent = msg;
            el.style.display = "block";
          } else {
            alert(msg);
          }
          if (debug) console.error(msg);
          return;
        }
      }
      const json = await res.json();
      // GraphQLのエラーコードに応じて分岐
      if (json?.errors?.length) {
        const codes = json.errors
          .map((e) => e?.extensions?.code)
          .filter(Boolean);
        const isAuthError = codes.some((c) =>
          [
            "UNAUTHENTICATED",
            "TOKEN_EXPIRED",
            "FORBIDDEN",
            "PERMISSION_DENIED",
          ].includes(String(c))
        );
        if (isAuthError) {
          // 認証系エラーはトークン破棄してログインへ
          try {
            localStorage.removeItem("api_token");
          } catch {}
          const next = encodeURIComponent(
            location.pathname + location.search + location.hash
          );
          if (!debug) location.href = `/login?next=${next}`;
          if (debug) {
            const firstMsg = json.errors[0]?.message || "";
            const el = document.getElementById("admin-guard-error");
            const msg = `GraphQL認証系エラー: ${firstMsg} code=${codes.join(",")}`;
            if (el) {
              el.textContent = msg;
              el.style.display = "block";
            }
            console.error(msg, json.errors);
          }
          return;
        } else {
          // その他のGraphQLエラーはメッセージ表示
          const firstMsg =
            json.errors[0]?.message || "不明なエラーが発生しました";
          const el = document.getElementById("admin-guard-error");
          if (el) {
            el.textContent = `エラー: ${firstMsg}`;
            el.style.display = "block";
          } else {
            alert(`エラー: ${firstMsg}`);
          }
          if (debug) console.error("GraphQLエラー詳細", json.errors);
          return;
        }
      }
      const me = json?.data?.me;
      if (!(me && (me.is_admin || me.is_manager))) {
        // 権限なし → 403 ページへ
        if (!debug) location.href = "/403";
        if (debug) {
          const el = document.getElementById("admin-guard-error");
          const msg = `権限不足: is_admin=${me?.is_admin} is_manager=${me?.is_manager}`;
          if (el) {
            el.textContent = msg;
            el.style.display = "block";
          }
          console.warn(msg, me);
        }
        return;
      }
    } catch (e) {
      // Network or runtime error: treat as unauthenticated
      const msg = `ネットワークまたは実行時エラー: ${e?.message || e}`;
      const el = document.getElementById("admin-guard-error");
      if (el) {
        el.textContent = msg;
        el.style.display = "block";
      }
      console.error(msg, e);
      if (!debug) {
        try {
          localStorage.removeItem("api_token");
        } catch {}
        const next = encodeURIComponent(
          location.pathname + location.search + location.hash
        );
        location.href = `/login?next=${next}`;
      }
    }
  })();
</script>
