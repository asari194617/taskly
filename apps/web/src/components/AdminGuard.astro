---
const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
---
<script>
  const _apiBase = "{apiBase}";
  (async () => {
    const token = localStorage.getItem('api_token') || '';
    if (!token) { location.href = '/login'; return; }
    const res = await fetch(_apiBase + "/graphql", {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', ...(token ? { 'Authorization': token } : {}) },
      body: JSON.stringify({ query: 'query{ me{ id email is_admin is_manager } }' })
    });
    if(!res.ok){ location.href = '/login'; return; }
    const json = await res.json();
    const me = json?.data?.me;
    if(!(me && (me.is_admin || me.is_manager))){
      alert('Forbidden');
      location.href = '/';
    }
  })();
</script>
