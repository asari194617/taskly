<script type="module">
  const API_BASE = (import.meta.env && import.meta.env.PUBLIC_API_URL) || 'http://localhost:8080';
  (async () => {
    try {
      const token = localStorage.getItem('api_token') || '';
      if (!token) { location.href = '/login'; return; }
      const headers = { 'Content-Type': 'application/json' };
      if (token) headers['Authorization'] = token.startsWith('Bearer ') ? token : `Bearer ${token}`;
      const res = await fetch(`${API_BASE}/graphql`, {
        method: 'POST',
        headers,
        body: JSON.stringify({ query: 'query{ me{ id email is_admin is_manager } }' })
      });
      if(!res.ok){ location.href = '/login'; return; }
      const json = await res.json();
      const me = json?.data?.me;
      if(!(me && (me.is_admin || me.is_manager))){
        alert('Forbidden');
        location.href = '/';
      }
    } catch (e) {
      // Network or runtime error: treat as unauthenticated
      location.href = '/login';
    }
  })();
</script>
