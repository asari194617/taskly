<script type="module">
  const API_BASE = (import.meta.env && import.meta.env.PUBLIC_API_URL) || 'http://localhost:3063';
  (async () => {
    try {
      const token = localStorage.getItem('api_token') || '';
      if (!token) {
        const next = encodeURIComponent(location.pathname + location.search + location.hash);
        location.href = `/login?next=${next}`;
        return;
      }
  const headers = { 'Content-Type': 'application/json', 'X-Client-Platform': 'web' } as Record<string,string>;
      if (token) headers['Authorization'] = token.startsWith('Bearer ') ? token : `Bearer ${token}`;
      const res = await fetch(`${API_BASE}/graphql`, {
        method: 'POST',
        headers,
        body: JSON.stringify({ query: 'query{ me{ id email is_admin is_manager } }' })
      });
      if(!res.ok){
        // Tokenが無効/期限切れの可能性が高いので破棄してログインへ
        try { localStorage.removeItem('api_token'); } catch {}
        const next = encodeURIComponent(location.pathname + location.search + location.hash);
        location.href = `/login?next=${next}`;
        return;
      }
      const json = await res.json();
      const me = json?.data?.me;
      if(!(me && (me.is_admin || me.is_manager))){
        // 権限なし → 403 ページへ
        location.href = '/403';
        return;
      }
    } catch (e) {
      // Network or runtime error: treat as unauthenticated
      try { localStorage.removeItem('api_token'); } catch {}
      const next = encodeURIComponent(location.pathname + location.search + location.hash);
      location.href = `/login?next=${next}`;
    }
  })();
</script>
