---
import Layout from "../../layouts/AppLayout.astro";

export function getStaticPaths() {
  return ["password", "select", "totp", "mail-code", "recovery", "passkey"].map((legacy) => ({ params: { legacy } }));
}
---
<Layout title="ログイン">
  <main class="mx-auto max-w-md px-4 py-16 text-center">
    <h1 class="text-xl font-semibold">認証ページに移動しています</h1>
    <p class="mt-3 text-sm text-muted-foreground">ログインの方法は認証ページで選択できます。</p>
    <a class="mt-6 inline-block text-sm font-medium text-primary underline-offset-4 hover:underline" href="/login">ログインに進む</a>
  </main>
  <script>
    import { legacyLoginURL } from "@/lib/login-redirect";
    location.replace(legacyLoginURL(location.search));
  </script>
</Layout>
