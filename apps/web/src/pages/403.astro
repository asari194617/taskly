---
import Layout from "../layouts/AppLayout.astro";
import { Button } from "@/components/ui/button";
import { ArrowLeft } from "lucide-react";
---
<Layout title="アクセスが拒否されました">
  <div class="mx-auto max-w-md py-16 text-center space-y-4">
    <div class="text-6xl font-bold">403</div>
    <div class="text-lg">アクセスが拒否されました</div>
    <div class="text-sm text-muted-foreground">このページはご利用いただけません。</div>
    <div class="pt-4">
      <a href="/">
        <Button className="inline-flex items-center gap-2">
          <ArrowLeft className="h-4 w-4" />
          ホームへ戻る
        </Button>
      </a>
    </div>
  </div>
  
</Layout>
