---
const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
---
<html>
  <head>
    <meta charset="utf-8" />
    <title>Login</title>
  </head>
  <body>
    <h1>Login</h1>
    <section>
      <h2>Request Code</h2>
      <form id="reqForm">
        <input name="email" type="email" placeholder="Email" required />
        <button type="submit">Send Code</button>
      </form>
    </section>
    <section>
      <h2>Login</h2>
      <form id="loginForm">
        <input name="email" type="email" placeholder="Email" required />
        <input name="code" placeholder="Email Code (if available)" />
        <input name="totp" placeholder="TOTP (if 2FA enabled)" />
        <input name="recovery_code" placeholder="Recovery Code (optional)" />
        <button type="submit">Login</button>
      </form>
      <div id="result" style="white-space: pre-wrap"></div>
    </section>
    <script>
      const apiBase = "{apiBase}";
      document.getElementById('reqForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const res = await fetch(`${apiBase}/auth/request-code`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ email: fd.get('email') }) });
        document.getElementById('result').textContent = res.status === 202 ? 'Code sent' : 'Failed';
      });
      document.getElementById('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const body = { email: fd.get('email'), code: fd.get('code') || '', totp: fd.get('totp') || '', recovery_code: fd.get('recovery_code') || '' };
        const res = await fetch(`${apiBase}/auth/login`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
        const out = await res.json().catch(()=>({}));
        if(res.ok && out && out.token){ localStorage.setItem('api_token', out.token); location.href = '/'; }
        else { document.getElementById('result').textContent = JSON.stringify(out||{error:'login failed'}, null, 2); }
      });
    </script>
  </body>
</html>
