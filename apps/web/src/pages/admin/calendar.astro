---
import AdminGuard from "../../components/AdminGuard.astro";
const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
---
<html>
  <head>
    <meta charset="utf-8" />
    <title>Business Calendar</title>
  </head>
  <body>
    <AdminGuard />
    <h1>Business Calendar</h1>
    <form id="calForm">
      <input name="start" type="date" required />
      <input name="end" type="date" required />
      <label><input type="checkbox" name="is_business_day" /> Is Business Day</label>
      <input name="notes" placeholder="Notes (optional)" />
      <button type="submit">Apply</button>
    </form>
    <script>
      const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
      const token = localStorage.getItem('api_token') || '';
      const headers = token ? { 'Authorization': token, 'Content-Type': 'application/json' } : { 'Content-Type': 'application/json' };
      document.getElementById('calForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const isBiz = fd.get('is_business_day') === 'on';
        await fetch(`${apiBase}/admin/calendar/upsert-range`, { method: 'POST', headers, body: JSON.stringify({ start: fd.get('start'), end: fd.get('end'), is_business_day: isBiz, notes: fd.get('notes') || null }) });
        alert('Applied');
      });
    </script>
  </body>
</html>
