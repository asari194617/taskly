---
import Layout from "../../layouts/AppLayout.astro";
import AdminGuard from "../../components/AdminGuard.astro";
import { gql } from "../../lib/graphql";
const idx = await gql<{ dayShiftIndex: number }>(`query{ dayShiftIndex }`).catch(() => ({ dayShiftIndex: 0 }));
// Fetch cycles and groups (assuming existing GraphQL schema: dayShiftCycles and dayShiftGroups(cycle_id))
const data = await gql<{ dayShiftCycles: { id:number; name:string }[], dayShiftGroups: { id:number; cycle_id:number; members:number[] }[]}>(
  `query{ dayShiftCycles{ id name } dayShiftGroups{ id cycle_id members } }`
).catch(() => ({ dayShiftCycles: [], dayShiftGroups: [] }));
---
<Layout title="日直管理">
  <AdminGuard />
  <section class="space-y-6">
    <div class="space-y-3">
      <h2 class="text-lg font-semibold">インデックス制御</h2>
      <div class="flex items-center gap-3">
        <span class="px-3 py-2 rounded border">現在値: {idx.dayShiftIndex}</span>
        <input id="idx-new" type="number" class="px-2 py-1 rounded border w-28" value={String(idx.dayShiftIndex)} />
        <button id="idx-save" class="px-3 py-1 rounded bg-primary text-primary-foreground">更新</button>
      </div>
    </div>

    <div class="space-y-3">
      <h2 class="text-lg font-semibold">サイクル</h2>
      <div class="space-y-2">
        <ul class="space-y-1">
          {data.dayShiftCycles.map((c) => (
            <li class="flex items-center gap-2">
              <span class="px-2 py-1 rounded border">#{c.id} {c.name}</span>
              <button class="px-2 py-1 rounded bg-secondary" data-edit-cycle={c.id}>編集</button>
              <button class="px-2 py-1 rounded bg-destructive text-destructive-foreground" data-delete-cycle={c.id}>削除</button>
            </li>
          ))}
        </ul>
        <div class="flex items-center gap-2">
          <input id="cycle-name" placeholder="新規サイクル名" class="px-2 py-1 rounded border" />
          <button id="cycle-add" class="px-3 py-1 rounded bg-primary text-primary-foreground">追加</button>
        </div>
      </div>
    </div>

    <div class="space-y-3">
      <h2 class="text-lg font-semibold">グループ</h2>
      <p class="text-sm text-muted-foreground">各サイクルに紐づくグループを管理します。</p>
      <div id="groups" class="space-y-2">
        {data.dayShiftGroups.map((g) => (
          <div class="border rounded p-2 space-y-2">
            <div class="flex items-center gap-2">
              <span class="px-2 py-1 rounded border">#{g.id} (cycle:{g.cycle_id})</span>
              <button class="px-2 py-1 rounded bg-secondary" data-edit-group={g.id}>編集</button>
              <button class="px-2 py-1 rounded bg-destructive text-destructive-foreground" data-delete-group={g.id}>削除</button>
            </div>
            <div class="text-sm">メンバー: {g.members.join(", ")}</div>
          </div>
        ))}
      </div>
      <div class="flex items-center gap-2">
        <select id="group-cycle" class="px-2 py-1 rounded border">
          {data.dayShiftCycles.map((c) => (
            <option value={String(c.id)}>{c.name}</option>
          ))}
        </select>
        <input id="group-members" placeholder="ユーザーIDをカンマで" class="px-2 py-1 rounded border w-64" />
        <button id="group-add" class="px-3 py-1 rounded bg-primary text-primary-foreground">追加</button>
      </div>
    </div>

    <script type="module">
      import { gql } from "../../lib/graphql";
      const idxBtn = document.getElementById("idx-save");
      const idxInp = document.getElementById("idx-new");
      idxBtn?.addEventListener("click", async () => {
        const v = parseInt(idxInp.value || "0", 10);
        await gql(`mutation($v:Int!){ updateDayShiftIndex(value:$v) }`, { v });
        alert("更新しました");
        location.reload();
      });

      // Cycle CRUD
      document.querySelectorAll('[data-delete-cycle]')?.forEach((el) => {
        el.addEventListener('click', async () => {
          const id = parseInt(el.getAttribute('data-delete-cycle'));
          if(!confirm('削除しますか？')) return;
          await gql(`mutation($id:Int!){ deleteDayShiftCycle(id:$id) }`, { id });
          location.reload();
        });
      });
      const addCycleBtn = document.getElementById('cycle-add');
      const addCycleName = document.getElementById('cycle-name');
      addCycleBtn?.addEventListener('click', async () => {
        const name = addCycleName.value.trim();
        if(!name){ alert('名前を入力してください'); return; }
        await gql(`mutation($name:String!){ createDayShiftCycle(name:$name){ id } }`, { name });
        location.reload();
      });

      // Group CRUD
      document.querySelectorAll('[data-delete-group]')?.forEach((el) => {
        el.addEventListener('click', async () => {
          const id = parseInt(el.getAttribute('data-delete-group'));
          if(!confirm('削除しますか？')) return;
          await gql(`mutation($id:Int!){ deleteDayShiftGroup(id:$id) }`, { id });
          location.reload();
        });
      });
      const addGroupBtn = document.getElementById('group-add');
      const addGroupCycle = document.getElementById('group-cycle');
      const addGroupMembers = document.getElementById('group-members');
      addGroupBtn?.addEventListener('click', async () => {
        const cycle_id = parseInt(addGroupCycle.value || '0', 10);
        const members = (addGroupMembers.value || '').split(',').map(s=>parseInt(s.trim(),10)).filter(n=>!isNaN(n));
        if(!cycle_id || members.length===0){ alert('サイクルとメンバーを指定してください'); return; }
        await gql(`mutation($cycle_id:Int!,$members:[Int!]!){ createDayShiftGroup(cycle_id:$cycle_id, members:$members){ id } }`, { cycle_id, members });
        location.reload();
      });
    </script>
  </section>
</Layout>
