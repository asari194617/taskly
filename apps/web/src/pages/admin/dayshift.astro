---
import AdminGuard from "../../components/AdminGuard.astro";
const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
---
<html>
  <head>
    <meta charset="utf-8" />
    <title>Day Shift Admin</title>
    <style>
      body { font-family: system-ui, sans-serif; padding: 1rem; }
      form { margin-bottom: 1rem; }
      input, button { margin: 0.25rem; }
      table { border-collapse: collapse; margin-top: 1rem; }
      th, td { border: 1px solid #ccc; padding: 0.25rem 0.5rem; }
    </style>
  </head>
  <body>
    <AdminGuard />
    <h1>Day Shift Admin</h1>
    <section>
      <h2>Cycles</h2>
      <form id="cycleForm">
        <input name="begin" type="date" required />
        <input name="finish" type="date" required />
        <input name="description" placeholder="Description" required />
        <button type="submit">Create Cycle</button>
      </form>
      <table id="cyclesTbl"><thead><tr><th>ID</th><th>Begin</th><th>Finish</th><th>Description</th><th>Actions</th></tr></thead><tbody></tbody></table>
    </section>
    <section>
      <h2>Pairs</h2>
      <form id="pairForm">
        <input name="cycle_id" type="number" placeholder="Cycle ID" required />
        <input name="user1_id" type="number" placeholder="User1 ID" required />
        <input name="user2_id" type="number" placeholder="User2 ID" required />
        <button type="submit">Add Pair</button>
      </form>
      <table id="pairsTbl"><thead><tr><th>ID</th><th>Cycle</th><th>User1</th><th>User2</th><th>Position</th><th>Actions</th></tr></thead><tbody></tbody></table>
    </section>
    <script>
      const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
      const token = localStorage.getItem('api_token') || '';
      const headers = token ? { 'Authorization': token, 'Content-Type': 'application/json' } : { 'Content-Type': 'application/json' };
      async function loadCycles(){
        const res = await fetch(`${apiBase}/admin/dayshift/cycles`, { headers });
        const data = await res.json();
        const tbody = document.querySelector('#cyclesTbl tbody');
        tbody.innerHTML = '';
        (data||[]).forEach(c => {
          const tr = document.createElement('tr');
          tr.innerHTML = `<td>${c.id}</td><td>${c.begin_date?.substring(0,10) || ''}</td><td>${c.finish_date?.substring(0,10) || ''}</td><td>${c.description||''}</td><td><button data-del="${c.id}">Delete</button></td>`;
          tbody.appendChild(tr);
        });
      }
      async function loadPairs(){
        const cycleId = document.querySelector('input[name="cycle_id"]').value;
        if(!cycleId) return;
        const res = await fetch(`${apiBase}/admin/dayshift/cycles/${cycleId}/pairs`, { headers });
        const data = await res.json();
        const tbody = document.querySelector('#pairsTbl tbody');
        tbody.innerHTML = '';
        (data||[]).forEach(p => {
          const tr = document.createElement('tr');
          tr.innerHTML = `<td>${p.id}</td><td>${p.cycle_id}</td><td>${p.user1_id}</td><td>${p.user2_id}</td><td>${p.position}</td><td><button data-pdel="${p.id}">Delete</button></td>`;
          tbody.appendChild(tr);
        });
      }
      document.getElementById('cycleForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        await fetch(`${apiBase}/admin/dayshift/cycles`, { method: 'POST', headers, body: JSON.stringify({ begin_date: fd.get('begin'), finish_date: fd.get('finish'), description: fd.get('description') }) });
        e.target.reset();
        await loadCycles();
      });
      document.getElementById('pairsTbl').addEventListener('click', async (e) => {
        const id = e.target.getAttribute('data-pdel');
        const cycleId = document.querySelector('input[name="cycle_id"]').value;
        if(id && cycleId){ await fetch(`${apiBase}/admin/dayshift/cycles/${cycleId}/pairs/${id}`, { method: 'DELETE', headers }); loadPairs(); }
      });
      document.getElementById('cyclesTbl').addEventListener('click', async (e) => {
        const id = e.target.getAttribute('data-del');
        if(id){ await fetch(`${apiBase}/admin/dayshift/cycles/${id}`, { method: 'DELETE', headers }); loadCycles(); }
      });
      document.getElementById('pairForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const cid = fd.get('cycle_id');
        await fetch(`${apiBase}/admin/dayshift/cycles/${cid}/pairs`, { method: 'POST', headers, body: JSON.stringify({ user1_id: Number(fd.get('user1_id')), user2_id: Number(fd.get('user2_id')) }) });
        await loadPairs();
      });
      document.querySelector('input[name="cycle_id"]').addEventListener('change', loadPairs);
      loadCycles();
    </script>
  </body>
  </html>
