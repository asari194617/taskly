---
import AppLayout from "../../layouts/AppLayout.astro";
import { gql } from "../../lib/graphql";
const initial = await gql<{ dayShiftIndex: number }>(`query{ dayShiftIndex }`).catch(() => ({ dayShiftIndex: 0 }));
---
<AppLayout>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold">日直インデックス</h2>
    <p class="text-sm text-muted-foreground">現在の値を確認・更新できます。</p>
    <div id="idx" class="flex items-center gap-3">
      <span class="px-3 py-2 rounded border">現在値: {initial.dayShiftIndex}</span>
      <input id="newv" type="number" class="px-2 py-1 rounded border w-24" value={String(initial.dayShiftIndex)} />
      <button id="save" class="px-3 py-1 rounded bg-primary text-primary-foreground">更新</button>
    </div>
    <script type="module">
      import { gql } from "../../lib/graphql";
      const btn = document.getElementById("save");
      const inp = document.getElementById("newv");
      btn?.addEventListener("click", async () => {
        const v = parseInt(inp.value || "0", 10);
        try{
          await gql(`mutation($v:Int!){ adminUpdateDayShiftIndex(index:$v) }`, { v });
          alert("更新しました");
          location.reload();
        }catch(e){
          alert("更新に失敗しました: " + (e?.message || e));
        }
      });
    </script>
  </section>
</AppLayout>
