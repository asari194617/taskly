---
import AdminGuard from "../../components/AdminGuard.astro";
import Layout from "../../layouts/AppLayout.astro";
---
<Layout title="Admin">
  <AdminGuard />
  <div class="mx-auto max-w-3xl space-y-6">
    <div class="space-y-2">
      <h1 class="text-2xl font-semibold">管理画面</h1>
      <p class="text-sm text-muted-foreground">ユーザー、カレンダー、日直の管理を行います。</p>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      <a href="/admin/day-shift" class="block rounded-lg border p-4 hover:bg-accent hover:text-accent-foreground">
        <div class="font-medium">日直</div>
        <div class="text-sm text-muted-foreground">サイクルとペアの管理</div>
      </a>
      <!-- Business calendar feature removed -->
      <a href="/admin/users" class="block rounded-lg border p-4 hover:bg-accent hover:text-accent-foreground">
        <div class="font-medium">ユーザー</div>
        <div class="text-sm text-muted-foreground">検索・ロール・ブロック管理</div>
      </a>
      <a href="/admin/subject" class="block rounded-lg border p-4 hover:bg-accent hover:text-accent-foreground">
        <div class="font-medium">教科</div>
        <div class="text-sm text-muted-foreground">教科の追加・編集・削除</div>
      </a>
      <a href="/admin/reports" class="block rounded-lg border p-4 hover:bg-accent hover:text-accent-foreground">
        <div class="font-medium">通報</div>
        <div class="text-sm text-muted-foreground">通報の管理</div>
      </a>
    </div>
  </div>
</Layout>
