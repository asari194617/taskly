---
import Layout from "../../layouts/AdminLayout.astro";
const sections = [
  { href: "/admin/users", title: "ユーザー", description: "ユーザーの検索、追加、権限と利用状態の管理" },
  { href: "/admin/day-shift", title: "日直", description: "サイクル、グループ、担当順の設定" },
  { href: "/admin/task-defaults", title: "課題タイプの初期設定", description: "タイプごとの完了マークの初期値" },
  { href: "/admin/subject", title: "教科", description: "教科の追加、編集、有効期限の管理" },
  { href: "/admin/reports", title: "通報", description: "ユーザーから届いた通報の確認" },
  { href: "/admin/moderation", title: "モデレーション", description: "フラグ付き課題の確認と自動非表示の設定" },
];
---
<Layout>
  <div class="space-y-2">
    <h1 class="text-xl font-semibold">管理メニュー</h1>
    <p class="text-sm text-muted-foreground">作業する項目を選んでください。</p>
  </div>
  <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {sections.map((section) => (
      <a href={section.href} class="group block rounded-lg border bg-card p-5 transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
        <h2 class="font-semibold group-hover:underline">{section.title} <span aria-hidden="true">↗</span></h2>
        <p class="mt-2 text-sm text-muted-foreground">{section.description}</p>
      </a>
    ))}
  </div>
</Layout>
