---
import Layout from "../layouts/AppLayout.astro";
import TasksList from "../react/TasksList";
---
<Layout title="Home">
  <div class="mx-auto max-w-3xl space-y-6">
    <div class="space-y-2">
      <h1 class="text-2xl font-semibold">課題一覧</h1>
      <p class="text-sm text-muted-foreground">期限が近い順に表示します。</p>
    </div>
    <div>
      <TasksList client:load />
    </div>
  </div>
</Layout>
