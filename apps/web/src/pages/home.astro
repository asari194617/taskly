---
import Layout from "../layouts/AppLayout.astro";
import TasksList from "../react/TasksList";
---
<Layout title="Home">
  <div class="mx-auto max-w-3xl space-y-6">
    <div class="space-y-2">
      <h1 class="text-2xl font-semibold" data-i18n-key="home.title">課題一覧</h1>
      <p class="text-sm text-muted-foreground" data-i18n-key="home.description">期限が近い順に表示します。</p>
    </div>
    <div>
      <TasksList client:load />
    </div>
  </div>
</Layout>

<script>
  import { updateI18nTexts, watchLanguageChange } from "@/lib/i18n-dom";
  import { requireAuth } from "@/lib/auth-guard";
  // Protect this page
  requireAuth();
  
  // 初回ロード時に更新
  updateI18nTexts();
  
  // 言語変更を監視
  watchLanguageChange();
</script>
