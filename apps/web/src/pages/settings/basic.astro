---
import Layout from "../../layouts/AppLayout.astro";
import SettingsBasic from "@/react/settings/Basic";
---
<Layout title="Basic">
  <h1 class="sr-only" data-i18n-key="settingsBasic.heading">基本設定</h1>
  <SettingsBasic client:load />
  <script>
    import { updateI18nTexts, watchLanguageChange } from "@/lib/i18n-dom";
    import { requireAuth } from "@/lib/auth-guard";
    requireAuth();
    updateI18nTexts();
    watchLanguageChange();
  </script>
</Layout>
