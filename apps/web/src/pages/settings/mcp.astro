---
import Layout from "../../layouts/AppLayout.astro";
import SettingsMcp from "../../react/settings/Mcp";
---
<Layout title="MCP">
  <h1 class="sr-only" data-i18n-key="settingsMcp.heading">MCP 設定</h1>
  <SettingsMcp client:load />
  <script>
    import { updateI18nTexts, watchLanguageChange } from "@/lib/i18n-dom";
    import { requireAuth } from "@/lib/auth-guard";
    requireAuth();
    updateI18nTexts();
    watchLanguageChange();
  </script>
</Layout>
