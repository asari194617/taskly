---
import "../styles/globals.css";
import UserMenu from "../react/UserMenu";
import AppShell from "../react/AppShell";
const {
  title = "Taskly",
  description = "シンプルなタスク管理・通知サービス",
} = Astro.props;
const siteName = "Taskly";
const ogImage = "https://cdn.taskly.iy0306.com/assets/thumbnail-dark.webp";
const faviconUrl = "https://cdn.taskly.iy0306.com/assets/favicon.webp";
const appleTouchIconUrl = "https://cdn.taskly.iy0306.com/assets/apple-touch-icon.png";
const canonical = typeof Astro.url !== 'undefined' ? Astro.url.toString() : undefined;
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    
    <!-- Icons -->
    <link rel="icon" href={faviconUrl} type="image/webp" />
    <link rel="apple-touch-icon" href={appleTouchIconUrl} />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:locale" content="ja_JP" />
    {canonical && <meta property="og:url" content={canonical} />}
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    {canonical && <link rel="canonical" href={canonical} />}
    <script>
      // set initial theme ASAP to avoid FOUC
      (function(){
        try {
          const mq = window.matchMedia('(prefers-color-scheme: dark)');
          const stored = localStorage.getItem('theme');
          const wantDark = stored ? stored === 'dark' : mq.matches;
          if (wantDark) document.documentElement.classList.add('dark');
          else document.documentElement.classList.remove('dark');
        } catch {}
      })();
    </script>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0b0f19" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="container p-4 flex items-center justify-between">
      <a href="/" class="font-semibold">Taskly</a>
      <div class="flex items-center gap-2">
        <button id="themeToggle" class="inline-flex items-center justify-center h-9 w-9 rounded-md border bg-background text-foreground hover:bg-accent hover:text-accent-foreground">
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
            <path d="M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12Zm0 4a1 1 0 0 1-1-1v-1a1 1 0 1 1 2 0v1a1 1 0 0 1-1 1ZM12 4a1 1 0 0 1-1-1V2a1 1 0 1 1 2 0v1a1 1 0 0 1-1 1Zm8 8a1 1 0 0 1 1-1h1a1 1 0 1 1 0 2h-1a1 1 0 0 1-1-1ZM2 13a1 1 0 0 1 0-2h1a1 1 0 1 1 0 2H2Zm15.657 6.657a1 1 0 0 1 0-1.414l.707-.707a1 1 0 1 1 1.414 1.414l-.707.707a1 1 0 0 1-1.414 0ZM4.222 6.343A1 1 0 0 1 5.636 4.93l.707.707A1 1 0 1 1 4.93 7.05l-.707-.707a1 1 0 0 1 0-1.414Zm14.142-1.414a1 1 0 0 1 0 1.414l-.707.707A1 1 0 0 1 16.243 5.95l.707-.707a1 1 0 0 1 1.414 0ZM5.636 19.071a1 1 0 0 1-1.414-1.414l.707-.707A1 1 0 1 1 6.343 18.364l-.707.707Z" />
          </svg>
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 hidden">
            <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 1 0 9.79 9.79Z" />
          </svg>
          <span class="sr-only">Toggle theme</span>
        </button>
        <UserMenu client:load />
      </div>
    </header>
    <main class="container p-4 flex-1">
      <slot />
    </main>
    <AppShell client:load />
    <script>
      // Keep <html lang> in sync with selected language
      (function(){
        try {
          const apply = () => {
            const lang = localStorage.getItem('display_lang') || 'ja';
            document.documentElement.setAttribute('lang', lang);
          };
          apply();
          window.addEventListener('languagechange', apply);
          window.addEventListener('storage', (e) => {
            if (e.key === 'display_lang') apply();
          });
        } catch {}
      })();
    </script>
    <script>
      (function(){
        const btn = document.getElementById('themeToggle');
        const sun = document.getElementById('icon-sun');
        const moon = document.getElementById('icon-moon');
        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        function applyTheme(){
          const stored = localStorage.getItem('theme');
          const wantDark = stored ? stored === 'dark' : mq.matches;
          document.documentElement.classList.toggle('dark', wantDark);
          const dark = wantDark;
          if (dark) { sun?.classList.add('hidden'); moon?.classList.remove('hidden'); }
          else { sun?.classList.remove('hidden'); moon?.classList.add('hidden'); }
        }
        applyTheme();
        if (typeof mq.addEventListener === 'function') {
          mq.addEventListener('change', applyTheme);
        } else if (typeof (mq as any).addListener === 'function') {
          (mq as any).addListener(applyTheme);
        }
        btn?.addEventListener('click', () => {
          const nowDark = document.documentElement.classList.contains('dark');
          const next = !nowDark;
          localStorage.setItem('theme', next ? 'dark' : 'light');
          applyTheme();
        });
      })();
    </script>
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
