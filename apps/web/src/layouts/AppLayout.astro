---
import "../styles/globals.css";
const { title = "Taskly" } = Astro.props;
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <main class="container py-8">
      <slot />
    </main>
  </body>
</html>
