---
import "../styles/global.css";
import UserMenu from "../react/UserMenu";
import AppShell from "../react/AppShell";
import { buildCanonicalUrl } from "../lib/canonical-url.mjs";
const {
  title = "Taskly",
  description = "タスク管理・通知サービス",
} = Astro.props;
const siteName = "Taskly";
const ogImage = "https://cdn.taskly.iy0306.com/assets/thumbnail-dark.webp";
const faviconUrl = "https://cdn.taskly.iy0306.com/assets/favicon.webp";
const appleTouchIconUrl = "https://cdn.taskly.iy0306.com/assets/apple-touch-icon.png";
const canonical = buildCanonicalUrl(Astro.url, Astro.site);
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    
    <!-- Icons -->
    <link rel="icon" href={faviconUrl} type="image/webp" />
    <link rel="apple-touch-icon" href={appleTouchIconUrl} />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonical} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <link rel="canonical" href={canonical} />
    <script>
      // set initial theme ASAP to avoid FOUC
      (function(){
        try {
          const mq = window.matchMedia('(prefers-color-scheme: dark)');
          const stored = localStorage.getItem('theme');
          const wantDark = stored ? stored === 'dark' : mq.matches;
          if (wantDark) document.documentElement.classList.add('dark');
          else document.documentElement.classList.remove('dark');
        } catch {}
      })();
    </script>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0b0f19" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="p-4 flex items-center justify-between">
      <style>
        .logo {
          height: 1.5rem;
          width: auto;
        }
        .logo>path { fill: black; }
        .dark .logo>path { fill: white; }
      </style>
      <a href="/" class="font-semibold">
        <svg width="558" height="160" viewBox="0 0 558 160" fill="none" xmlns="http://www.w3.org/2000/svg" class="logo">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M20 40C20 37.2386 22.2386 35 25 35H125C127.761 35 130 37.2386 130 40V100C130 102.761 127.761 105 125 105H25C22.2386 105 20 102.761 20 100V40ZM20 114.146C14.174 112.087 10 106.531 10 100V40C10 31.7157 16.7157 25 25 25H125C133.284 25 140 31.7157 140 40V100C140 106.531 135.826 112.087 130 114.146V120C130 128.284 123.284 135 115 135H35C26.7157 135 20 128.284 20 120V114.146ZM120 115V120C120 122.761 117.761 125 115 125H35C32.2386 125 30 122.761 30 120V115H120Z"/>
          <path d="M219.568 128V51.712H194.48V38.4H259.248V51.712H233.392V128H219.568ZM300.024 128V84.224C300.024 80.4693 298.659 77.44 295.928 75.136C293.283 72.7467 289.912 71.552 285.816 71.552C282.061 71.552 278.648 72.32 275.576 73.856C272.589 75.392 269.859 77.7387 267.384 80.896L258.808 72.32C262.819 67.968 267.128 64.7253 271.736 62.592C276.429 60.4587 281.464 59.392 286.84 59.392C291.96 59.392 296.397 60.2453 300.152 61.952C303.907 63.6587 306.808 66.176 308.856 69.504C310.904 72.7467 311.928 76.7147 311.928 81.408V128H300.024ZM279.928 129.28C275.576 129.28 271.693 128.427 268.28 126.72C264.867 125.013 262.136 122.667 260.088 119.68C258.125 116.608 257.144 113.024 257.144 108.928C257.144 105.344 257.784 102.187 259.064 99.456C260.344 96.7253 262.221 94.464 264.696 92.672C267.256 90.88 270.413 89.5147 274.168 88.576C278.008 87.6373 282.403 87.168 287.352 87.168H306.04L304.888 97.664H285.688C283.128 97.664 280.824 97.92 278.776 98.432C276.813 98.8587 275.107 99.584 273.656 100.608C272.291 101.547 271.267 102.699 270.584 104.064C269.901 105.344 269.56 106.88 269.56 108.672C269.56 110.549 270.029 112.213 270.968 113.664C271.907 115.029 273.187 116.096 274.808 116.864C276.429 117.632 278.307 118.016 280.44 118.016C283.512 118.016 286.413 117.504 289.144 116.48C291.96 115.371 294.435 113.877 296.568 112C298.787 110.123 300.493 108.032 301.688 105.728L304.76 114.304C302.968 117.291 300.749 119.893 298.104 122.112C295.459 124.331 292.6 126.08 289.528 127.36C286.456 128.64 283.256 129.28 279.928 129.28ZM350.991 129.28C345.359 129.28 340.282 128.299 335.759 126.336C331.236 124.373 327.482 121.472 324.495 117.632L333.455 109.952C336.015 112.939 338.788 115.115 341.775 116.48C344.847 117.76 348.303 118.4 352.143 118.4C353.679 118.4 355.087 118.229 356.367 117.888C357.732 117.461 358.884 116.864 359.823 116.096C360.847 115.328 361.615 114.432 362.127 113.408C362.639 112.299 362.895 111.104 362.895 109.824C362.895 107.605 362.084 105.813 360.463 104.448C359.61 103.851 358.244 103.211 356.367 102.528C354.575 101.76 352.228 100.992 349.327 100.224C344.378 98.944 340.324 97.4933 337.167 95.872C334.01 94.2507 331.578 92.416 329.871 90.368C328.591 88.7467 327.652 86.9973 327.055 85.12C326.458 83.1573 326.159 81.024 326.159 78.72C326.159 74.9653 327.226 71.6373 329.359 68.736C331.492 65.8347 334.351 63.5733 337.935 61.952C341.604 60.2453 345.7 59.392 350.223 59.392C353.38 59.392 356.495 59.8187 359.567 60.672C362.724 61.5253 365.626 62.7627 368.271 64.384C370.916 66.0053 373.135 67.9253 374.927 70.144L367.375 78.464C365.754 76.8427 363.962 75.4347 361.999 74.24C360.122 72.96 358.202 71.9787 356.239 71.296C354.276 70.6133 352.484 70.272 350.863 70.272C349.071 70.272 347.45 70.4427 345.999 70.784C344.548 71.1253 343.311 71.6373 342.287 72.32C341.348 73.0027 340.623 73.856 340.111 74.88C339.599 75.904 339.343 77.056 339.343 78.336C339.428 79.4453 339.684 80.512 340.111 81.536C340.623 82.4747 341.306 83.2853 342.159 83.968C343.098 84.6507 344.506 85.376 346.383 86.144C348.26 86.912 350.65 87.6373 353.551 88.32C357.818 89.4293 361.316 90.6667 364.047 92.032C366.863 93.312 369.082 94.8053 370.703 96.512C372.41 98.1333 373.604 100.011 374.287 102.144C374.97 104.277 375.311 106.667 375.311 109.312C375.311 113.152 374.202 116.608 371.983 119.68C369.85 122.667 366.948 125.013 363.279 126.72C359.61 128.427 355.514 129.28 350.991 129.28ZM401.873 107.008L401.233 92.672L433.361 60.8H451.153L401.873 107.008ZM389.841 128V33.28H403.025V128H389.841ZM435.153 128L409.809 98.432L419.153 89.856L452.049 128H435.153ZM462.222 128V33.28H475.406V128H462.222ZM503.48 157.44L517.048 126.08L517.176 136.576L483.64 60.8H499L519.992 110.208C520.419 111.061 520.931 112.384 521.528 114.176C522.125 115.883 522.637 117.589 523.064 119.296L519.736 120.064C520.419 118.272 521.059 116.48 521.656 114.688C522.339 112.896 522.979 111.104 523.576 109.312L541.112 60.8H556.728L529.08 128L517.688 157.44H503.48Z"/>
        </svg>
      </a>
      <div class="flex items-center gap-2">
        <button id="themeToggle" class="inline-flex items-center justify-center h-9 w-9 rounded-md border bg-background text-foreground hover:bg-accent hover:text-accent-foreground">
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
            <path d="M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12Zm0 4a1 1 0 0 1-1-1v-1a1 1 0 1 1 2 0v1a1 1 0 0 1-1 1ZM12 4a1 1 0 0 1-1-1V2a1 1 0 1 1 2 0v1a1 1 0 0 1-1 1Zm8 8a1 1 0 0 1 1-1h1a1 1 0 1 1 0 2h-1a1 1 0 0 1-1-1ZM2 13a1 1 0 0 1 0-2h1a1 1 0 1 1 0 2H2Zm15.657 6.657a1 1 0 0 1 0-1.414l.707-.707a1 1 0 1 1 1.414 1.414l-.707.707a1 1 0 0 1-1.414 0ZM4.222 6.343A1 1 0 0 1 5.636 4.93l.707.707A1 1 0 1 1 4.93 7.05l-.707-.707a1 1 0 0 1 0-1.414Zm14.142-1.414a1 1 0 0 1 0 1.414l-.707.707A1 1 0 0 1 16.243 5.95l.707-.707a1 1 0 0 1 1.414 0ZM5.636 19.071a1 1 0 0 1-1.414-1.414l.707-.707A1 1 0 1 1 6.343 18.364l-.707.707Z" />
          </svg>
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 hidden">
            <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 1 0 9.79 9.79Z" />
          </svg>
          <svg id="icon-system" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 hidden">
            <path d="M4 3h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-6v2h3a1 1 0 1 1 0 2H7a1 1 0 1 1 0-2h3v-2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm0 2v10h16V5H4Z" />
          </svg>
          <span class="sr-only">Toggle theme</span>
        </button>
        <UserMenu client:load />
      </div>
    </header>
    <main class="p-4 flex-1">
      <slot />
    </main>
    <AppShell client:load />
    <script>
      // Keep <html lang> in sync with selected language
      (function(){
        try {
          const apply = () => {
            const lang = localStorage.getItem('display_lang') || 'ja';
            document.documentElement.setAttribute('lang', lang);
          };
          apply();
          window.addEventListener('languagechange', apply);
          window.addEventListener('storage', (e) => {
            if (e.key === 'display_lang') apply();
          });
        } catch {}
      })();
    </script>
    <script>
      (function(){
        const btn = document.getElementById('themeToggle');
        const sun = document.getElementById('icon-sun');
        const moon = document.getElementById('icon-moon');
        const system = document.getElementById('icon-system');
        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        // 'light' | 'dark' | 'system'; system follows the OS preference
        function getMode(){
          const stored = localStorage.getItem('theme');
          return stored === 'light' || stored === 'dark' ? stored : 'system';
        }
        function applyTheme(){
          const mode = getMode();
          const wantDark = mode === 'dark' || (mode === 'system' && mq.matches);
          document.documentElement.classList.toggle('dark', wantDark);
          sun?.classList.toggle('hidden', mode !== 'light');
          moon?.classList.toggle('hidden', mode !== 'dark');
          system?.classList.toggle('hidden', mode !== 'system');
        }
        applyTheme();
        if (typeof mq.addEventListener === 'function') {
          mq.addEventListener('change', applyTheme);
        } else if (typeof (mq as any).addListener === 'function') {
          (mq as any).addListener(applyTheme);
        }
        btn?.addEventListener('click', () => {
          const order = ['light', 'dark', 'system'];
          const next = order[(order.indexOf(getMode()) + 1) % order.length];
          if (next === 'system') localStorage.removeItem('theme');
          else localStorage.setItem('theme', next);
          applyTheme();
        });
      })();
    </script>
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register('/sw.js', { updateViaCache: 'none' })
            .catch(() => {});
        });
      }
    </script>
  </body>
</html>
