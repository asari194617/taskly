---
const { title } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? "Taskly policy archive"}</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 52rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.8; }
      h1, h2 { line-height: 1.35; }
      a { color: #1558a6; }
    </style>
  </head>
  <body><main><slot /></main></body>
</html>
