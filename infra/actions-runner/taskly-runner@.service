[Unit]
Description=Taskly single-job GitHub Actions runner slot %i
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=taskly-runner
Group=taskly-runner
EnvironmentFile=-/etc/taskly-runner/runner.env
ExecStart=/opt/taskly-runner/run-slot.sh %i
# Stopping the Docker CLI alone leaves its daemon-managed container running.
ExecStop=-/opt/taskly-runner/stop-slot.sh %i
# Keep the launcher alive long enough to remove its per-job workspace.
KillMode=mixed
Restart=always
RestartSec=2
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
