[Unit]
Description=Taskly single-job GitHub Actions runner slot %i
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=nishikawa
Group=nishikawa
ExecStart=/opt/taskly-runner/run-slot.sh %i
# Stopping the Docker CLI alone leaves its daemon-managed container running.
ExecStop=-/usr/bin/docker stop --timeout 10 taskly-ci-slot-%i
# Keep the launcher alive long enough to remove its per-job workspace.
KillMode=mixed
Restart=always
RestartSec=2
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
