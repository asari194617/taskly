{"uid":"taskly-operations","title":"Taskly Operations","schemaVersion":41,"version":1,"refresh":"30s","timezone":"browser","time":{"from":"now-6h","to":"now"},"panels":[{"id":1,"title":"API requests / second","type":"timeseries","datasource":{"type":"prometheus","uid":"taskly-prometheus"},"gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"sum(rate(taskly_http_requests_total{route!=\"/healthz\"}[5m]))","refId":"A"}]},{"id":2,"title":"API 5xx rate","type":"timeseries","datasource":{"type":"prometheus","uid":"taskly-prometheus"},"gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"sum(rate(taskly_http_requests_total{status=~\"5..\",route!=\"/healthz\"}[5m])) / clamp_min(sum(rate(taskly_http_requests_total{route!=\"/healthz\"}[5m])), 0.001)","refId":"A"}]},{"id":3,"title":"API p95 latency (seconds)","type":"timeseries","datasource":{"type":"prometheus","uid":"taskly-prometheus"},"gridPos":{"h":8,"w":12,"x":0,"y":8},"targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(taskly_http_request_duration_seconds_bucket{route!=\"/healthz\"}[5m])))","refId":"A"}]},{"id":4,"title":"Health probe success","type":"timeseries","datasource":{"type":"prometheus","uid":"taskly-prometheus"},"gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"probe_success{job=\"taskly-services\"}","refId":"A"}]},{"id":5,"title":"Job queue by status","type":"timeseries","datasource":{"type":"prometheus","uid":"taskly-prometheus"},"gridPos":{"h":8,"w":12,"x":0,"y":16},"targets":[{"expr":"taskly_integration_jobs","refId":"A"}]},{"id":6,"title":"Oldest job age (seconds)","type":"timeseries","datasource":{"type":"prometheus","uid":"taskly-prometheus"},"gridPos":{"h":8,"w":12,"x":12,"y":16},"targets":[{"expr":"taskly_integration_job_oldest_age_seconds","refId":"A"}]},{"id":7,"title":"Delivery attempts / second","type":"timeseries","datasource":{"type":"prometheus","uid":"taskly-prometheus"},"gridPos":{"h":8,"w":12,"x":0,"y":24},"targets":[{"expr":"sum by (kind, outcome) (rate(integrati