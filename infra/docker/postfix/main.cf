# Minimal postfix config for local relay
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no
# Minimal postfix config for local relay
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no

# ===================== WARNING =====================
# This config is for LOCAL DEVELOPMENT ONLY.
# DO NOT USE in production. It disables TLS and allows open relay.
# mynetworks = 0.0.0.0/0 is extremely dangerous and must NEVER be used in production.
# For production, use a proper mail provider or MTA with:
#   - TLS enabled (smtpd_use_tls=yes, smtp_use_tls=yes)
#   - smtp_tls_security_level=may or encrypt
#   - smtpd_tls_security_level=may or encrypt
#   - mynetworks restricted to trusted hosts only
#   - authentication and relay restrictions enforced
#   - valid certificates (no InsecureSkipVerify)
# ===================================================

# TLS off for local dev
smtpd_use_tls=no
smtp_use_tls=no

myhostname = postfix
myorigin = $myhostname
mydestination = $myhostname, localhost.localdomain, localhost
relayhost =
inet_interfaces = all
inet_protocols = ipv4

mynetworks = 0.0.0.0/0
local_recipient_maps =
relay_domains = $mydestination

smtp_tls_security_level = none
smtpd_tls_security_level = none
smtpd_peername_lookup = no

# OpenDKIM Milter 設定
milter_protocol = 2
milter_default_action = accept

# OpenDKIM ソケットの指定
smtpd_milters = unix:/var/run/opendkim/opendkim.sock
non_smtpd_milters = unix:/var/run/opendkim/opendkim.sock