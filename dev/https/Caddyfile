{
	admin off
	auto_https disable_redirects
	default_bind 127.0.0.1
}

(local_tls) {
	tls {$TASKLY_DEV_TLS_DIR}/taskly.pem {$TASKLY_DEV_TLS_DIR}/taskly-key.pem
	header X-Robots-Tag "noindex, nofollow"
}

