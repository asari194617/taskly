# Global
NODE_ENV=development
TIMEZONE=Asia/Tokyo

# Web
WEB_PUBLIC_URL=http://localhost:4321

# API (Go)
API_PORT=8080
API_PUBLIC_URL=http://localhost:3063
API_CORS_ORIGINS=http://localhost:4321,https://web.local
AUTH_ISSUER=http://localhost:3067
AUTH_CLIENT_ID=taskly-web
AUTH_CLIENT_SECRET=
AUTH_REDIRECT_URI=http://localhost:3063/auth/oauth/callback
AUTH_PASSKEYS_EXTERNAL=0
AUTH_PASSWORD_EXTERNAL=0
AUTH_EMAIL_SETTINGS_EXTERNAL=0
AUTH_RECOVERY_EXTERNAL=0
AUTH_TOTP_EXTERNAL=0
AUTH_BLOCKS_EXTERNAL=0
AUTH_BLOCK_SYNC_URL=
AUTH_INTERNAL_TOKEN=
AUTH_ACCOUNT_LIFECYCLE_EXTERNAL=0
AUTH_LIFECYCLE_SYNC_URL=
WEB_PUBLIC_URL=http://localhost:4321

# Database (MySQL)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=taskly
MYSQL_USER=taskly
MYSQL_PASSWORD=taskly_password
# Airflow metadata only. Keep these different from the application database/account.
# Use a URL-safe password (for example: openssl rand -hex 32).
AIRFLOW_META_DATABASE=taskly_airflow
AIRFLOW_META_USER=taskly_airflow
AIRFLOW_META_PASSWORD=change_me_airflow_meta_password
DB_HOST=db
# Compose-internal MySQL port. MySQL has no host port mapping; a process run
# directly on the host needs an explicitly configured tunnel or port mapping.
DB_PORT=3306
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10

# Redis
REDIS_ADDR=redis:6379
REDIS_USERNAME=taskly
# Generate a unique production secret, for example: openssl rand -base64 48
REDIS_PASSWORD=change_me_redis_password
REDIS_DB=0

# Auth / Security
JWT_SECRET=change_me
TOTP_ENC_KEY=please_change_this_random_long_key
# Always true when NODE_ENV=production; optionally enable for local HTTPS.
# SESSION_COOKIE_SECURE=true

# Email (external SMTP provider; no SMTP relay is included in Compose)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@taskly.local
SMTP_USER=resend
SMTP_PASSWORD=your_password_here
SMTP_TLS=starttls
SMTP_TIMEOUT=60
SMTP_USE_AUTH=auto

# Discord
DISCORD_WEBHOOK_URL=

# Optional dedicated Discord-compatible webhook for host disk alerts.
# Falls back to DISCORD_WEBHOOK_URL when empty.
DISK_ALERT_WEBHOOK_URL=

# Production host disk monitoring and retention (infra/ops/disk-maintenance.sh)
DISK_WARN_PERCENT=70
DISK_CRITICAL_PERCENT=80
DISK_EMERGENCY_PERCENT=90
DISK_DEPLOY_MAX_PERCENT=85
DISK_DEPLOY_MIN_FREE_GIB=10
DOCKER_RETENTION_HOURS=168
AIRFLOW_LOG_RETENTION_DAYS=14
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_COPIES=3

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Moderation notifications
ADMIN_REVIEW_URL=http://localhost:4321/admin/moderation

# Teams callback
TEAMS_NOTIFY_EMAIL=
TEAMS_INTEGRATION_SECRET=your-secret-here
# Comma-separated HTTPS origins for Teams status callbacks; no callback is sent if unset.
TEAMS_CALLBACK_ALLOWED_ORIGINS=
# Workers for each integration kind (teams_inbound, teams_callback, task_discord, task_email); 1-8, default 1.
INTEGRATION_JOB_WORKERS_PER_KIND=1

# iCal
ICAL_BASE_URL=http://localhost:3063/ical

# Prometheus metrics
METRICS_BIND_ADDR=0.0.0.0:9464

# CORS
CORS_ALLOW_CREDENTIALS=true

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Datadog
# Docker Compose overrides the transport with the host Agent Unix sockets.
# DD_AGENT_HOST and DD_TRACE_AGENT_PORT remain useful when running services directly.
DD_AGENT_HOST=localhost
DD_TRACE_AGENT_PORT=8126
DD_SERVICE=taskly
DD_ENV=development
DD_VERSION=1.0.0
DD_TRACE_SAMPLE_RATE=
DD_PROFILING_ENABLED=false
DD_DB_SERVICE=

# OpenTelemetry API traces (optional, OTLP/HTTP)
# Set either endpoint to enable export. The generic endpoint receives /v1/traces automatically.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://collector:4318/v1/traces
OTEL_TRACES_SAMPLE_RATE=0.1

# Encrypted backup: age public recipient and explicit FTPS destination
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=14
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=ftp_user
FTP_PASSWORD=ftp_password
FTP_DIR=/backups

# Web Push (generate a VAPID key pair before enabling Web Push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@taskly.local

# MCP server
MCP_HOST=0.0.0.0
MCP_PORT=3066

# WebAuthn
WEBAUTHN_RP_NAME=Taskly
WEBAUTHN_RP_ID=taskly.iy0306.com
WEBAUTHN_ORIGIN=https://taskly.iy0306.com

# Email inbound integration (Cloudflare Email Workers -> Server)
EMAIL_INTEGRATION_SECRET=change_me_email_inbound_secret

# School calendar URL (for DAY_SHIFT_OFF events)
SCHOOL_CAL_URL=
# Optional override for the Japan holiday iCalendar feed
JAPAN_HOLIDAYS_ICS_URL=https://one.webcal.jp/JapanHolidays/

# AirFlow
AIRFLOW__API_AUTH__JWT_SECRET=change_me
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change_me
