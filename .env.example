# Global
NODE_ENV=development
TIMEZONE=Asia/Tokyo

# Web
WEB_PUBLIC_URL=http://localhost:4321

# API (Go)
API_PORT=8080
API_PUBLIC_URL=http://localhost:8080
API_CORS_ORIGINS=http://localhost:4321,https://web.local

# Database (MySQL)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=taskly
MYSQL_USER=taskly
MYSQL_PASSWORD=taskly_password
DB_HOST=db
DB_PORT=3060
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth / Security
JWT_SECRET=change_me
PASSWORD_PEPPER=change_me
SESSION_TTL_HOURS=720
TOTP_ENC_KEY=please_change_this_random_long_key

# Email (Postfix relay inside docker)
SMTP_HOST=postfix
SMTP_PORT=587
SMTP_FROM=noreply@taskly.local
SMTP_USER=resend
SMTP_PASSWORD=your_password_here
SMTP_TLS=starttls
SMTP_TIMEOUT=60

# Discord
DISCORD_WEBHOOK_URL=

# Optional dedicated Discord-compatible webhook for host disk alerts.
# Falls back to DISCORD_WEBHOOK_URL when empty.
DISK_ALERT_WEBHOOK_URL=

# Google Gemini
GEMINI_API_KEY=

# Teams callback
TEAMS_STATUS_WEBHOOK_URL=http://localhost:8080/integrations/teams/status
TEAMS_NOTIFY_EMAIL=
TEAMS_INTEGRATION_SECRET=your-secret-here

# iCal
ICAL_BASE_URL=http://localhost:8080/ical

# Prometheus metrics
METRICS_BIND_ADDR=0.0.0.0:9464

# GraphQL
GRAPHQL_ENABLE=true

# CORS
CORS_ALLOW_CREDENTIALS=true

# Day Shift
DAYSHIFT_ENABLED=true
DAYSHIFT_NOTIFY_TIME=08:30
DAYSHIFT_INBOUND_SECRET=change_me

# Sentry
SENTRY_DSN=

# Datadog
DD_AGENT_HOST=localhost
DD_TRACE_AGENT_PORT=8126
DD_SERVICE=taskly
DD_ENV=development
DD_VERSION=1.0.0
DD_API_KEY=your_datadog_api_key
DD_KEY_ID=

# FTP server (for backup)
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=ftp_user
FTP_PASSWORD=ftp_password

# CloudFlare R2 credentials
CDN_PUBLIC_BASE_URL=https://cdn.taskly.iy0306.com

# MCP server
MCP_HOST=0.0.0.0
MCP_PORT=3066

# CloudFlare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WebAuthn
WEBAUTHN_RP_NAME=Taskly
WEBAUTHN_RP_ID=taskly.iy0306.com
WEBAUTHN_ORIGIN=https://taskly.iy0306.com

# Email inbound integration (Cloudflare Email Workers -> Server)
EMAIL_INTEGRATION_SECRET=change_me_email_inbound_secret

# School calendar URL (for automatic holiday fetching)
SCHOOL_CAL_URL=

# AirFlow
AIRFLOW__API_AUTH__JWT_SECRET=
