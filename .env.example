# Global
NODE_ENV=development
TIMEZONE=Asia/Tokyo

# API (Go)
API_PORT=8080
API_PUBLIC_URL=http://localhost:8080
API_CORS_ORIGINS=http://localhost:4321,https://web.local

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=taskly
DB_PASSWORD=taskly_password
DB_NAME=taskly
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth / Security
JWT_SECRET=change_me
PASSWORD_PEPPER=change_me
SESSION_TTL_HOURS=720
TOTP_ENC_KEY=please_change_this_random_long_key

# Email (Postfix relay inside docker)
SMTP_HOST=postfix
SMTP_PORT=25
SMTP_FROM=noreply@taskly.local
SMTP_PASSWORD=your_password_here

# Discord
DISCORD_WEBHOOK_URL=

# Google Gemini
GEMINI_API_KEY=

# Teams callback
TEAMS_STATUS_WEBHOOK_URL=http://localhost:8080/integrations/teams/status
TEAMS_NOTIFY_EMAIL=
TEAMS_INTEGRATION_SECRET=your-secret-here

# iCal
ICAL_BASE_URL=http://localhost:8080/ical

# Prometheus metrics
METRICS_BIND_ADDR=127.0.0.1:9464

# GraphQL
GRAPHQL_ENABLE=true

# CORS
CORS_ALLOW_CREDENTIALS=true

# Day Shift
DAYSHIFT_ENABLED=true
DAYSHIFT_NOTIFY_TIME=08:30
DAYSHIFT_INBOUND_SECRET=change_me

# Sentry
SENTRY_DSN=

# FTP server (for backup)
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=ftp_user
FTP_PASSWORD=ftp_password