# Global
NODE_ENV=development
TIMEZONE=Asia/Tokyo

# Web
WEB_PUBLIC_URL=http://localhost:4321

# API (Go)
API_PORT=8080
API_PUBLIC_URL=http://localhost:3063
API_CORS_ORIGINS=http://localhost:4321,https://web.local

# Database (MySQL)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=taskly
MYSQL_USER=taskly
MYSQL_PASSWORD=taskly_password
DB_HOST=db
# Compose-internal MySQL port. For a server run directly on the host, use
# DB_HOST=127.0.0.1 and DB_PORT=3060 instead.
DB_PORT=3306
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10

# Redis
REDIS_ADDR=redis:6379
REDIS_USERNAME=taskly
# Generate a unique production secret, for example: openssl rand -base64 48
REDIS_PASSWORD=change_me_redis_password
REDIS_DB=0

# Auth / Security
JWT_SECRET=change_me
TOTP_ENC_KEY=please_change_this_random_long_key

# Email (external SMTP provider; no SMTP relay is included in Compose)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@taskly.local
SMTP_USER=resend
SMTP_PASSWORD=your_password_here
SMTP_TLS=starttls
SMTP_TIMEOUT=60
SMTP_USE_AUTH=auto

# Discord
DISCORD_WEBHOOK_URL=

# Optional dedicated Discord-compatible webhook for host disk alerts.
# Falls back to DISCORD_WEBHOOK_URL when empty.
DISK_ALERT_WEBHOOK_URL=

# Production host disk monitoring and retention (infra/ops/disk-maintenance.sh)
DISK_WARN_PERCENT=70
DISK_CRITICAL_PERCENT=80
DISK_EMERGENCY_PERCENT=90
DISK_DEPLOY_MAX_PERCENT=85
DISK_DEPLOY_MIN_FREE_GIB=10
DOCKER_RETENTION_HOURS=168
AIRFLOW_LOG_RETENTION_DAYS=14
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_COPIES=3

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Moderation notifications
ADMIN_EMAIL_LOCALE=ja
ADMIN_REVIEW_URL=http://localhost:4321/admin/moderation

# Teams callback
TEAMS_NOTIFY_EMAIL=
TEAMS_INTEGRATION_SECRET=your-secret-here

# iCal
ICAL_BASE_URL=http://localhost:3063/ical

# Prometheus metrics
METRICS_BIND_ADDR=0.0.0.0:9464

# CORS
CORS_ALLOW_CREDENTIALS=true

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Datadog
# Docker Compose overrides the transport with the host Agent Unix sockets.
# DD_AGENT_HOST and DD_TRACE_AGENT_PORT remain useful when running services directly.
DD_AGENT_HOST=localhost
DD_TRACE_AGENT_PORT=8126
DD_SERVICE=taskly
DD_ENV=development
DD_VERSION=1.0.0
DD_TRACE_SAMPLE_RATE=
DD_PROFILING_ENABLED=false
DD_DB_SERVICE=

# FTP server (for backup)
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=ftp_user
FTP_PASSWORD=ftp_password
FTP_DIR=/backups
FTP_CHMOD=640

# Web Push (generate a VAPID key pair before enabling Web Push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@taskly.local

# MCP server
MCP_HOST=0.0.0.0
MCP_PORT=3066

# WebAuthn
WEBAUTHN_RP_NAME=Taskly
WEBAUTHN_RP_ID=taskly.iy0306.com
WEBAUTHN_ORIGIN=https://taskly.iy0306.com

# Email inbound integration (Cloudflare Email Workers -> Server)
EMAIL_INTEGRATION_SECRET=change_me_email_inbound_secret

# School calendar URL (for automatic holiday fetching)
SCHOOL_CAL_URL=

# AirFlow
AIRFLOW__API_AUTH__JWT_SECRET=change_me
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change_me
